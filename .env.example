DATABASE_URL=postgres://postgres:postgres@localhost:5433/lifeos

# FX rates for finance module. Get key at https://exchangerate.host/
EXCHANGERATE_API_KEY=your_key_here

# Google Calendar integration (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Task reminders via macOS + Telegram (scripts/notify-upcoming.mjs)
# Bot token from @BotFather. Run `pnpm notify:telegram-setup` to discover chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma list of lead times in minutes. One notification per lead per task.
# Local launchd runs every 60s, so 30,5,1 with a 1-min window works there.
# The cloud cron (GitHub Actions) runs every 5 min — use wider values so no
# tick is missed: 30,15,5 with a 3-min window (the script defaults to these).
NOTIFY_LEAD_MINUTES=30,15,5
# Half-width (minutes) of fire window per lead. Must be ≥ half the cron cadence
# so no tick is missed. 5-min cron ⇒ 3. Local 60s launchd ⇒ 1.
NOTIFY_WINDOW_MINUTES=3
# Set to 1 to disable a channel
# NOTIFY_DISABLE_MACOS=1
# NOTIFY_DISABLE_TELEGRAM=1