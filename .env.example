# New empty database: never point the unified initializer at an old Life OS database.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lifeos_unified
APP_ORIGIN=http://localhost:3000
DATABASE_POOL_MAX_CONNECTIONS=3
REPORTING_CURRENCY=EUR
# Required for browser access. Use a unique password of at least 24 characters.
LIFE_OS_ACCESS_PASSWORD=
# Optional providers: omit until configured.
# ALPHA_VANTAGE_API_KEY=
# COINGECKO_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# For multiple Google accounts, use comma-separated tokens in connection order.
# GOOGLE_REFRESH_TOKENS=
# GOOGLE_ACCOUNT_LABELS=
# Local macOS reminder lead times; Web Push uses 30, 15 and 5 minutes.
# NOTIFY_LEAD_MINUTES=30,15,5
# NOTIFY_WINDOW_MINUTES=3
NOTIFY_DISABLE_MACOS=1
# Life OS Web Push. Generate once with: pnpm notify:setup --subject mailto:you@example.com
# Keep the same key pair across deployments. Never commit the private key.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=
# Enable only on the always-running server (Fly runtime enables it in fly.toml).
# PUSH_REMINDERS_ENABLED=1
